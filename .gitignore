# Dependencies and package-manager cache (recreated by npm install)
node_modules/
.npm-cache/

# Frontend build and tool output
dist/
*.tsbuildinfo
.vite/
coverage/

# Local environment files
.env
.env.*
!.env.example

# Locally generated backend storage. Keep directory placeholders tracked.
backend/storage/images/*
!backend/storage/images/.gitkeep
backend/storage/models/*
!backend/storage/models/.gitkeep
backend/storage/music/

# Progress notes
PROGRESS.md
start-dev.bat

# Tooling output
backend/.go-build-cache-*/

# Local editor and OS metadata
.vscode
!.vscode/settings.json
.DS_Store
Thumbs.db
*.psd~

# Locally installed agent skills and their installer lockfile.
.agents/skills/
skills-lock.json
