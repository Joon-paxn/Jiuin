# 开发环境留空时会默认连接 http://127.0.0.1:8080；生产环境留空时走同源 /api 反代。
# 仅在前后端确实部署于不同域名时填写公开的 HTTPS API 地址。
VITE_API_BASE_URL=
# Temporary visual experiment. Set to false to bypass the module without removing it.
VITE_ENABLE_TEMPORARY_ANIMATION=true
# Optional overrides. Cubism 3/4/5 uses the bundled Core when omitted.
# Relative paths use Vite's BASE_URL. An absolute URL must allow CORS from this
# site because the loader preflights it with fetch before inserting the script.
VITE_LIVE2D_CORE_URL=
# Cubism 2 models need the legacy live2d.min.js runtime.
# The same CORS requirement applies to an absolute override.
VITE_LIVE2D_CUBISM2_CORE_URL=
