# Copy to the server-only /etc/jiuin/jiuin.env and replace every placeholder.
# Never commit the populated file.
JIUIN_ENV=production
JIUIN_LOG_LEVEL=info
JIUIN_TIMEZONE=Asia/Shanghai
JIUIN_GO_LISTEN_ADDR=127.0.0.1:8080
JIUIN_SITE_NAME=Jiuin
JIUIN_SITE_PROJECT=Jiuin
JIUIN_SITE_DOMAIN=jiuin.cn
JIUIN_STORAGE_DIR=/var/lib/jiuin/music
JIUIN_DATABASE_PATH=/var/lib/jiuin/music/music.db
JIUIN_FFMPEG_PATH=/usr/bin/ffmpeg
JIUIN_FFPROBE_PATH=/usr/bin/ffprobe
JIUIN_MUSIC_FULL_BITRATE=320k
JIUIN_MUSIC_LITE_BITRATE=128k
JIUIN_MUSIC_OUTPUT_CODEC=libmp3lame
JIUIN_MUSIC_WORKER_INTERVAL=2s
JIUIN_MUSIC_PROCESSING_LEASE=2h
JIUIN_MUSIC_WORKER_INTERVAL_SECONDS=2
JIUIN_MUSIC_PROCESSING_LEASE_SECONDS=7200
JIUIN_MUSIC_ADMIN_TOKEN=replace-with-a-unique-32-character-minimum-admin-token
JIUIN_WS_ALLOWED_ORIGINS=https://jiuin.cn,https://www.jiuin.cn
JIUIN_SHARED_SERVICE_TOKEN=replace-with-a-unique-32-character-minimum-service-token
JIUIN_EXTERNAL_LINKS_JSON=[]
JIUIN_RESOURCE_MANIFEST_JSON=[]
JIUIN_BACKGROUND_URLS_JSON=[]
