JIUIN_ENV=production
JIUIN_SERVER_HOST=127.0.0.1
JIUIN_SERVER_PORT=8080
JIUIN_SERVER_READ_HEADER_TIMEOUT=5s
JIUIN_SERVER_READ_TIMEOUT=15s
JIUIN_SERVER_WRITE_TIMEOUT=30s
JIUIN_SERVER_IDLE_TIMEOUT=60s
JIUIN_SERVER_SHUTDOWN_TIMEOUT=10s
JIUIN_SITE_NAME=霁雪居
JIUIN_SITE_PROJECT=Jiuin
JIUIN_SITE_DOMAIN=Jiuin.cn
JIUIN_MUSIC_DIRECTORY=/var/lib/jiuin/music
# Keep this in sync with the exact Nginx upload location's client_max_body_size.
JIUIN_MUSIC_MAX_UPLOAD_SIZE=100MiB
JIUIN_FFMPEG_PATH=/usr/bin/ffmpeg
JIUIN_FFPROBE_PATH=/usr/bin/ffprobe
JIUIN_MUSIC_FULL_BITRATE=320k
JIUIN_MUSIC_LITE_BITRATE=128k
JIUIN_MUSIC_OUTPUT_CODEC=libmp3lame
JIUIN_MUSIC_WORKER_COUNT=2
# Maximum processing time for one FFprobe/FFmpeg job. Optional; defaults to 2h.
JIUIN_MUSIC_PROCESSING_TIMEOUT=2h
# Store a unique, high-entropy value in the server secret manager.
JIUIN_MUSIC_ADMIN_TOKEN=replace-with-a-second-long-random-production-token
JIUIN_CORS_ALLOWED_ORIGINS=https://jiuin.cn,https://www.jiuin.cn
JIUIN_SHARED_SERVICE_TOKEN=replace-with-a-long-random-production-token
JIUIN_MAIN_SITE_STATUS=online
JIUIN_BLOG_STATUS=unknown
JIUIN_EXTERNAL_LINKS_JSON=[]
JIUIN_RESOURCE_MANIFEST_JSON=[]
